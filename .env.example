# daymet-mcp settings (DAYMET_MCP_<SECTION>__<FIELD>). Copy to .env and use
# `uv run --env-file .env daymet-mcp`; .env is never loaded automatically.
# No real values belong in this file.

# DAYMET_MCP_SERVER__TRANSPORT=stdio
# DAYMET_MCP_SERVER__HOST=127.0.0.1
# DAYMET_MCP_SERVER__PORT=8080
# DAYMET_MCP_SERVER__LOG_LEVEL=INFO
# DAYMET_MCP_DOWNLOADS__DIR=./daymet-downloads
# DAYMET_MCP_CACHE__DISK_DIR=

# NASA Earthdata Login user token: only needed for areas above the credential-free limit
# (experimental backend; needs `uv sync --extra grid`). Environment only.
# DAYMET_MCP_EARTHDATA__TOKEN=
